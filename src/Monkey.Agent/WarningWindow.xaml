<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Monkey.Agent.WarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monkey"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True">

    <!-- Der Rand um die Karte wird in WarningWindow.ShadowGutter gesetzt: das
         Fenster ist genau so gross wie sein Inhalt, der Schlagschatten zeichnet
         aber ausserhalb davon und waere sonst an der Fensterkante abgeschnitten. -->
    <Border x:Name="Card"
            CornerRadius="14"
            Padding="34,22"
            Background="#F2141418"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            MouseLeftButtonDown="OnClick">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <StackPanel MinWidth="300">
            <!-- Der Affe gross ueber der Meldung. IsHitTestVisible=False, damit
                 auch ein Klick auf das Bild das Fenster schliesst. -->
            <Image Source="Assets/monkey.png"
                   Width="96" Height="96"
                   Margin="0,0,0,10"
                   HorizontalAlignment="Center"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="Headline"
                       Text="10 minutes left"
                       FontFamily="Segoe UI Semibold"
                       FontSize="30"
                       Foreground="#FFFFC14E"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="Subline"
                       Text="of screen time"
                       FontFamily="Segoe UI"
                       FontSize="14"
                       Foreground="#CCFFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
            <TextBlock Text="click to dismiss"
                       FontFamily="Segoe UI"
                       FontSize="10.5"
                       Foreground="#77FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</Window>
