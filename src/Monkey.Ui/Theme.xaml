<?xml version="1.0" encoding="utf-8"?>
<!--
    Das gemeinsame Aussehen von Steuerpult und Installationsassistent.

    Diese Datei liegt bewusst nicht in einem der beiden Projekte, sondern wird
    von beiden als verknuepfte Seite eingebunden (siehe die csproj-Dateien). So
    gibt es genau eine Palette und genau einen Satz Vorlagen - und trotzdem
    kein zusaetzliches Projekt, das gebaut und mitgeliefert werden muesste.

    Aufbau: erst Farben, dann Schrift, dann die Vorlagen der Bedienelemente,
    zuletzt das Fenster selbst.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Monkey.Ui">

    <!-- ==================================================== Farben ========= -->

    <!--
        Die Palette stammt aus assets/monkey.png. Die Zeichnung ist flach
        gehalten und benutzt nur eine Handvoll Farben; ausgezaehlt sind es der
        Reihe nach:

            #802D0E  das Fell des Kopfes  - traegt jetzt alles Handelnde
            #C3854D  die helle Schnauze   - die Markierung auf Schwarz
            #77AA88  das Halstuch         - alles Gelungene
            #6D230C  der Ohrschatten      - der gedrueckte Zustand
            #261B10  Pupille und Nase     - die Schriftfarbe

        Daraus wird nichts erfunden: die Grautoene sind warm angelegt, damit sie
        zum Braun gehoeren, statt daneben zu liegen. Alle Textpaarungen sind
        nachgerechnet und liegen ueber WCAG AA (4.5:1); die Werte stehen jeweils
        dahinter.
    -->

    <!-- Flaechen. Die Seite ist weiss und bleibt es: gegliedert wird mit Abstand,
         Ueberschriften und Haarlinien - nicht mit Kaesten. -->
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#FFF6F2ED"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FFE8DFD5"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#FFEDE6DE"/>
    <SolidColorBrush x:Key="WindowEdgeBrush" Color="#FFDDD2C6"/>

    <!-- Die Seitenspalte traegt Kontostand, Navigation und den Affen. Schwarz,
         weil der Bildhintergrund der Evolutionsstufen schwarz ist und die Spalte
         nahtlos in ihn uebergehen soll. -->
    <SolidColorBrush x:Key="SidebarBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="#FFA79B90"/>  <!-- 7.7:1 -->
    <SolidColorBrush x:Key="SidebarFaintBrush" Color="#FF847970"/>  <!-- 5.0:1 -->

    <!-- Die Schnauze. Auf Schwarz die einzige Farbe, die sich behauptet, ohne
         zu schreien - deshalb traegt sie die Auswahl in der Seitenspalte. -->
    <SolidColorBrush x:Key="SidebarAccentBrush" Color="#FFC3854D"/>  <!-- 6.8:1 -->

    <!-- Schriftfarben. Drei Stufen reichen: Aussage, Erlaeuterung, Beiwerk. -->
    <SolidColorBrush x:Key="TextBrush" Color="#FF261B10"/>       <!-- 16.8:1 -->
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF6E6055"/>  <!--  6.1:1 -->
    <SolidColorBrush x:Key="TextFaintBrush" Color="#FF807164"/>  <!--  4.7:1 -->

    <!-- Das Fell. Gedecktes Ziegelrot statt Bernstein: dunkel genug, um helle
         Schrift zu tragen (8.6:1), und dunkel genug, um auf Weiss selbst als
         Schrift und als Diagrammfarbe zu taugen (9.1:1). -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF802D0E"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF6D230C"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF5A1C09"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFFBF1ED"/>
    <SolidColorBrush x:Key="AccentLineBrush" Color="#FFEBD6CC"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF802D0E"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFF6F1"/>

    <!-- Eingabefelder und Schaltflaechen. -->
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#FFDDD2C6"/>
    <SolidColorBrush x:Key="FieldBorderHoverBrush" Color="#FFBDAE9E"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#FFFAF6F1"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#FFF1E9E0"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="#FFF8F5F1"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#FFB3A99E"/>

    <!-- Rueckmeldungen. Gelungenes traegt das Halstuch; das Rot fuer Fehler ist
         bewusst heller und satter als das Fell, damit es sich davon abhebt -
         die Hauptschaltflaeche ist ja schon rotbraun. -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#FFEFF5F0"/>
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#FFC9DFD1"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#FF33684A"/>   <!-- 5.9:1 -->
    <SolidColorBrush x:Key="SuccessDotBrush" Color="#FF77AA88"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFDEFEE"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#FFF2CFC8"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFB3261E"/>    <!-- 5.8:1 -->

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#FFCFC3B6"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#FFAD9E8E"/>

    <!-- ==================================================== Masse =========== -->

    <!-- Hoehe der Titelleiste. Die Leiste liegt ueber dem Inhalt; wer Platz
         fuer sie braucht, haelt sich mit CaptionInset davon frei. -->
    <Thickness x:Key="CaptionInset">0,46,0,0</Thickness>

    <!--
        Rundungen. Alles, was man anfassen kann, ist voll gerundet - der Radius
        entspricht der halben Hoehe, die Form ist also eine Kapsel. WPF deckelt
        einen zu grossen Radius selbst auf die halbe Kante, aber die Werte sind
        hier trotzdem ausgeschrieben: dann steht schwarz auf weiss, wie hoch das
        Element gemeint ist.
    -->
    <CornerRadius x:Key="PillRadius">17</CornerRadius>        <!-- Hoehe 34 -->
    <CornerRadius x:Key="SmallPillRadius">14</CornerRadius>   <!-- Hoehe 28 -->
    <CornerRadius x:Key="PanelRadius">20</CornerRadius>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="UiFontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="GlyphFont">Segoe MDL2 Assets</FontFamily>

    <!-- ==================================================== Schrift ========= -->

    <Style x:Key="Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontDisplay}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontDisplay}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="19"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="RowLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>

    <!-- ==================================================== Schaltflaechen == -->

    <!-- Die zurueckhaltende Grundform: weiss auf hellem Grund, feiner Rahmen.
         Alles, was nicht die Hauptsache einer Gruppe ist, sieht so aus. -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!-- Mehr Luft links und rechts als bei eckigen Knoepfen: sonst sitzt die
             Schrift in der Rundung. -->
        <Setter Property="Padding" Value="22,8"/>
        <Setter Property="MinWidth" Value="104"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource PillRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource FieldBorderHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource DisabledBrush}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Die eine Schaltflaeche, um die es in einer Gruppe geht. Bernstein mit
         dunkler Schrift - warm, und deutlich kontrastreicher als heller Text
         auf Bernstein es waere. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource PillRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceSunkenBrush}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource SurfaceSunkenBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rahmenlos, wirkt wie ein Verweis. Fuer Nebenwege ("… aendern"). -->
    <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <!-- Fuer das, was sich nicht ohne Weiteres zurueckholen laesst. -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
    </Style>

    <!-- Kleine Vorgabewerte neben einem Zahlenfeld. -->
    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="46"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Segmentschalter: mehrere Knoepfe in einer Schiene, einer davon gewaehlt.
         Traegt den Zeitraum der Statistik. -->
    <Style x:Key="SegmentButton" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{StaticResource SmallPillRadius}"
                            Padding="18,7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#FFEDE5DC"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource CardBrush}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Ein Farbfeld fuer die Zahl im Overlay. Rund, weil die Farbe selbst die
        ganze Aussage ist - ein Kasten drumherum brauchte eine Begruendung. Die
        gewaehlte Farbe traegt einen Ring, nicht bloss einen anderen Ton: an
        einem Ring erkennt man die Auswahl auch dann, wenn man Farben schlecht
        unterscheidet.
    -->
    <Style x:Key="Swatch" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Ellipse x:Name="Ring"
                                 Stroke="Transparent" StrokeThickness="2"
                                 Fill="Transparent"/>
                        <Ellipse x:Name="Dot"
                                 Width="22" Height="22"
                                 Fill="{TemplateBinding Background}"
                                 Stroke="{StaticResource FieldBorderBrush}"
                                 StrokeThickness="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{StaticResource SurfaceSunkenBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource FieldBorderHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================== Eingabefelder === -->

    <ControlTemplate x:Key="FieldTemplate" TargetType="TextBoxBase">
        <Border x:Name="Bg"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource PillRadius}"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                          Focusable="False" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource FieldBorderHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource DisabledBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceSunkenBrush}"/>
                <Setter TargetName="Bg" Property="BorderBrush" Value="Transparent"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.35"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource FieldTemplate}"/>
    </Style>

    <!-- Zahlen stehen rechtsbuendig, damit Ziffern untereinander fluchten. -->
    <Style x:Key="NumberField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Width" Value="88"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="Padding" Value="16,7"/>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.35"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource PillRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource FieldBorderHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource DisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================== Kontrollkaestchen -->

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="10,0,0,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Box" Grid.Column="0"
                                Width="19" Height="19" CornerRadius="9.5"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource FieldBorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="Tick"
                                  Data="M 0,4.2 L 3.4,7.6 L 9.4,1"
                                  Stroke="{StaticResource OnAccentBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Opacity="0"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ContentPresenter Grid.Column="1"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Tick" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource FieldBorderHoverBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource DisabledBrush}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Ein Schalter fuer eine Einstellungszeile: Beschriftung links, Schalter
        rechts am Rand, wie in jeder heutigen Systemsteuerung. Der Zustand steht
        an der Stellung des Knopfes, nicht nur an der Farbe.
    -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ContentPresenter Grid.Column="0"
                                          Margin="0,0,20,0"
                                          VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                          RecognizesAccessKey="True"/>

                        <Border x:Name="Track" Grid.Column="1"
                                Width="38" Height="22" CornerRadius="11"
                                Background="{StaticResource FieldBorderBrush}"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="Knob" Width="16" Height="16"
                                     Fill="#FFFFFFFF"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource FieldBorderHoverBrush}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentPressedBrush}"/>
                            <Setter TargetName="Track" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource DisabledBrush}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Der Regler. Dieselbe Sprache wie der Schalter darueber: bernsteinfarben
        fuer das Eingestellte, matt fuer den Rest, ein weisser Knopf mit Rand.
        Nur waagerecht - senkrecht gibt es hier nichts einzustellen.
    -->
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="20" Height="20" Background="Transparent">
                        <Ellipse x:Name="Knob" Width="18" Height="18"
                                 Fill="#FFFFFFFF"
                                 Stroke="{StaticResource AccentBrush}"
                                 StrokeThickness="2"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Stroke" Value="{StaticResource AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Knob" Property="Stroke" Value="{StaticResource AccentPressedBrush}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource AccentSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Knob" Property="Stroke" Value="{StaticResource DisabledTextBrush}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource DisabledBrush}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Die zurueckgelegte Strecke links vom Knopf. Sonst nur eine Flaeche zum Klicken. -->
    <Style x:Key="SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{StaticResource AccentBrush}"
                            CornerRadius="3" Height="6" VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderRest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" Height="20" VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Slider" TargetType="Slider">
        <Setter Property="Height" Value="20"/>
        <Setter Property="MinWidth" Value="180"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                Background="{StaticResource FieldBorderBrush}"/>

                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRest}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================== Abschnitte ====== -->

    <!--
        Die GroupBox ist jetzt schlicht ein Abschnitt: Ueberschrift, Inhalt,
        Abstand. Kein Kasten, kein Rahmen, kein Hintergrund. Was zusammengehoert,
        zeigt der Abstand - das ist der aeltere und ruhigere Trick als eine
        Umrandung, und er stapelt sich nicht.
    -->
    <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="0,0,0,32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <DockPanel LastChildFill="True">
                        <ContentPresenter DockPanel.Dock="Top"
                                          ContentSource="Header"
                                          Margin="0,0,0,14"
                                          TextBlock.FontFamily="{StaticResource UiFont}"
                                          TextBlock.FontSize="13.5"
                                          TextBlock.FontWeight="SemiBold"
                                          TextBlock.Foreground="{StaticResource TextBrush}"/>
                        <ContentPresenter/>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Die Haarlinie zwischen zwei Zeilen einer Einstellungsliste. -->
    <Style x:Key="RowRule" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource DividerBrush}"/>
        <Setter Property="Margin" Value="0,13"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ==================================================== Navigation ====== -->

    <!--
        Ein Eintrag der Seitenspalte. Auf Schwarz, also mit hellen Stufen: matt
        wenn ruhend, weiss wenn gewaehlt, dazu ein bernsteinfarbener Strich am
        Rand. Die Auswahl haengt damit nicht an der Farbe allein.
    -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource SidebarMutedBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Margin="0,1">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource PillRadius}"/>
                        <Border x:Name="Marker"
                                Width="3" Height="17" CornerRadius="1.5"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{StaticResource SidebarAccentBrush}"
                                Visibility="Collapsed"/>
                        <ContentPresenter Margin="15,9,12,10"
                                          VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF"/>
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================== Aufklapper ====== -->

    <Style x:Key="ExpanderHeaderButton" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="Transparent" Padding="0,6" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="Chevron"
                                  Data="M 0,0 L 4.5,4.5 L 0,9"
                                  Stroke="{StaticResource TextMutedBrush}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.35,0.5"/>
                            <ContentPresenter x:Name="Label" Margin="12,0,0,0" VerticalAlignment="Center"
                                              TextBlock.FontWeight="SemiBold"
                                              TextBlock.FontSize="13"
                                              TextBlock.Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextBlock.Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Label" Property="TextBlock.Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ein Nebenweg, der zugeklappt fast nichts vom Platz nimmt. -->
    <Style TargetType="Expander">
        <Setter Property="Margin" Value="0,0,0,32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel LastChildFill="True">
                        <ToggleButton DockPanel.Dock="Top"
                                      HorizontalAlignment="Left"
                                      Style="{StaticResource ExpanderHeaderButton}"
                                      Content="{TemplateBinding Header}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="Body" Margin="17,14,0,0" Visibility="Collapsed"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================== Fortschritt ===== -->

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"/>

                        <!-- Bestimmter Fortschritt: WPF setzt die Breite. -->
                        <Grid x:Name="PART_Track"/>
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="3"/>

                        <!-- Unbestimmter Fortschritt: ein Schimmer wandert durch.
                             Die Verschiebung sitzt auf dem Farbverlauf und
                             rechnet in Anteilen der Breite - so braucht es
                             keine Pixelmasse und keine Umrechner. -->
                        <Border x:Name="Shimmer" CornerRadius="3" Visibility="Collapsed">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform x:Name="Slide" X="-1"/>
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="#00802D0E" Offset="0"/>
                                    <GradientStop Color="#FF802D0E" Offset="0.5"/>
                                    <GradientStop Color="#00802D0E" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Opacity" Value="0"/>
                            <Setter TargetName="Shimmer" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="Sliding">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Slide"
                                                         Storyboard.TargetProperty="X"
                                                         From="-1" To="1" Duration="0:0:1.4"
                                                         RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Sliding"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================== Bildlaufleisten = -->

    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" Padding="3">
                        <Border x:Name="Bar" Background="{StaticResource ScrollThumbBrush}" CornerRadius="3"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ohne Pfeilknoepfe, schmal, nur ein Griff. Die Pfeilknoepfe waren der
         deutlichste Rest aus der alten Zeit. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumbStyle}" MinHeight="28"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPageButton}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumbStyle}" MinWidth="28"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPageButton}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==================================================== Kurzhinweise ==== -->

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="#FFF7F1EA"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#FF241A11" CornerRadius="14" Padding="14,8" MaxWidth="320">
                        <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================== Fenster ========= -->

    <!-- Die Knoepfe der Titelleiste. Segoe MDL2 Assets liefert die Glyphen, die
         Windows selbst benutzt - dieselbe Form, dieselben Masse. -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource GlyphFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent">
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#FFEDE5DC"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#FFE0D5C9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent">
                        <TextBlock x:Name="Glyph"
                                   Text="{TemplateBinding Content}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#FFE81123"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="#FFFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#FFC50F1F"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="#FFFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Der Fensterstil wird ausdruecklich zugewiesen (Style="{StaticResource
        AppWindow}"), nicht ueber den Typ gefunden: eine Vorlage ohne Schluessel
        greift in WPF nur bei genau diesem Typ, nicht bei abgeleiteten - und
        beide Fenster sind ja Ableitungen von ChromeWindow.
    -->
    <Style x:Key="AppWindow" TargetType="{x:Type ui:ChromeWindow}">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="46"
                              ResizeBorderThickness="6"
                              CornerRadius="0"
                              GlassFrameThickness="0"
                              UseAeroCaptionButtons="False"
                              NonClientFrameEdges="None"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:ChromeWindow}">
                    <Border x:Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource WindowEdgeBrush}"
                            BorderThickness="1">
                        <Grid>
                            <!-- Der Inhalt reicht bis unter die Leiste, damit
                                 randlose Grafiken die Oberkante erreichen. -->
                            <ContentPresenter/>

                            <Grid Height="46" VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{TemplateBinding Title}"
                                           Margin="{Binding CaptionPadding,
                                                    RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Button x:Name="PART_Minimize" Style="{StaticResource CaptionButton}"
                                            Content="&#xE921;" ToolTip="Minimise"/>
                                    <Button x:Name="PART_Maximize" Style="{StaticResource CaptionButton}"
                                            Content="&#xE922;" ToolTip="Maximise"/>
                                    <Button x:Name="PART_Close" Style="{StaticResource CaptionCloseButton}"
                                            Content="&#xE8BB;" ToolTip="Close"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="PART_Maximize" Property="Content" Value="&#xE923;"/>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanMinimize">
                            <Setter TargetName="PART_Maximize" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="PART_Maximize" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Minimize" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
