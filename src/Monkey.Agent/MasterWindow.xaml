<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Monkey.Agent.MasterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monkey – Control Panel"
        Width="700" Height="850"
        MinWidth="430" MinHeight="360"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFF7F7FA"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinWidth" Value="104"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Width" Value="66"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF77777F"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="GimmickColumn" Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Die Evolutionsstufe als volle Seitenspalte: randlos, ueber die ganze
             Fensterhoehe, ohne Beschriftung und ohne eigenen Hintergrund. Die
             Breite wird im Code aus der Hoehe berechnet, damit das Seitenver-
             haeltnis der Vorlage exakt erhalten bleibt und nichts verzerrt oder
             beschnitten wird. Nimmt keine Mausklicks an. -->
        <Image x:Name="Gimmick"
               Grid.Column="0"
               Stretch="UniformToFill"
               VerticalAlignment="Stretch"
               HorizontalAlignment="Left"
               IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality"/>

    <ScrollViewer Grid.Column="1"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="16,16,16,16">
        <StackPanel>

            <TextBlock x:Name="BalanceText" Text="Balance: –"
                       FontSize="19" FontWeight="SemiBold" Margin="0,0,0,3" TextWrapping="Wrap"/>
            <TextBlock x:Name="StateText" Text="" Foreground="#FF555560"
                       Margin="0,0,0,14" TextWrapping="Wrap"/>

            <GroupBox Header="Master password">
                <StackPanel>
                    <PasswordBox x:Name="MasterPassword" Padding="4,4" FontSize="14"/>
                    <TextBlock Text="Needed for everything below. Only the service ever checks it."
                               Style="{StaticResource Hint}" Margin="0,5,0,0"/>
                    <Button x:Name="RevealChangePasswordButton" Content="Change master password …"
                            Click="OnRevealChangePassword" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="ChangePasswordGroup" Header="Change master password" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="New:" Style="{StaticResource RowLabel}" Width="92"/>
                        <PasswordBox x:Name="NewPassword" Width="220" Padding="4,3"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Repeat:" Style="{StaticResource RowLabel}" Width="92"/>
                        <PasswordBox x:Name="NewPasswordRepeat" Width="220" Padding="4,3"/>
                    </StackPanel>
                    <Button x:Name="ChangePasswordButton" Content="Change password" Click="OnChangePassword"
                            HorizontalAlignment="Right" Margin="0,10,0,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Pause the limit">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="For:" Style="{StaticResource RowLabel}"/>
                    <ComboBox x:Name="PauseMinutes" Width="80" IsEditable="True" Text="60"
                              VerticalAlignment="Center">
                        <ComboBoxItem>15</ComboBoxItem>
                        <ComboBoxItem>30</ComboBoxItem>
                        <ComboBoxItem>60</ComboBoxItem>
                        <ComboBoxItem>120</ComboBoxItem>
                        <ComboBoxItem>240</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="min" Margin="6,0,0,0"/>
                    <Button x:Name="ResumeButton" Content="End pause" Click="OnResume" Margin="12,0,8,0"/>
                    <Button x:Name="PauseButton" Content="Start pause" Click="OnPause" IsDefault="True"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Adjust balance">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="Minus30Button" Content="−30 min" Click="OnMinus30"
                                MinWidth="110" Margin="0,0,10,0"/>
                        <Button x:Name="Plus30Button" Content="+30 min" Click="OnPlus30" MinWidth="110"/>
                    </StackPanel>
                    <TextBlock x:Name="GrantBudgetText" Text="" Style="{StaticResource Hint}"
                               Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Settings">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Per day:" Style="{StaticResource RowLabel}" Margin="0,4,10,4"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="DailyMinutes" Style="{StaticResource Field}" Margin="0,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="minutes" Style="{StaticResource Hint}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Balance cap:" Style="{StaticResource RowLabel}" Margin="0,4,10,4"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="CapMinutes" Style="{StaticResource Field}" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="minutes – how much can pile up" Style="{StaticResource Hint}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Warn at:" Style="{StaticResource RowLabel}" Margin="0,4,10,4"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="WarnMinutes" Style="{StaticResource Field}" Margin="0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="minutes left" Style="{StaticResource Hint}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Grace period:" Style="{StaticResource RowLabel}" Margin="0,4,10,4"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="GraceSeconds" Style="{StaticResource Field}" Margin="0,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="seconds before signing out" Style="{StaticResource Hint}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Buffer after sign-in:" Style="{StaticResource RowLabel}" Margin="0,4,10,4"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="LoginGraceSeconds" Style="{StaticResource Field}" Margin="0,4"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="seconds when the balance is empty" Style="{StaticResource Hint}"/>
                    </Grid>

                    <CheckBox x:Name="PauseOnLock" Content="Pause the clock while the session is locked" Margin="0,8,0,4"/>
                    <CheckBox x:Name="PauseOnScreensaver" Content="Pause the clock while the screensaver runs"/>
                    <Button x:Name="SaveConfigButton" Content="Save settings" Click="OnSaveConfig"
                            HorizontalAlignment="Right" Margin="0,10,0,0"/>

                    <Border x:Name="MessageBorder" Background="#FFE8E8EE" CornerRadius="5" Padding="10,7"
                            Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
    </Grid>
</Window>
