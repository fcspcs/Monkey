<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>..\..\assets\monkey.ico</ApplicationIcon>
    <AssemblyName>MonkeyService</AssemblyName>
    <RootNamespace>Monkey.Service</RootNamespace>
    <UserSecretsId>timeguard-service</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Monkey.Core\Monkey.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Oeffentlicher Schluessel fuer signierte Auto-Updates (tools/new-update-key.ps1).
         Fehlt die Datei, baut alles trotzdem - Auto-Update bleibt dann einfach aus. -->
    <EmbeddedResource Include="..\..\assets\update-key.pem"
                      Condition="Exists('..\..\assets\update-key.pem')"
                      LogicalName="update-key.pem" />
  </ItemGroup>

  <ItemGroup>
    <!-- Der optionale Telegram-Worker wird vom Control Panel direkt in das
         Cloudflare-Konto des Nutzers geladen. -->
    <EmbeddedResource Include="..\..\cloud\worker.js" LogicalName="telegram-worker.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Monkey.Tests" />
  </ItemGroup>

</Project>
