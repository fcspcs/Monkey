<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Monkey.Setup.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monkey Setup"
        Width="620" Height="560"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFF7F7FA"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF77777F"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with the monkey -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <Image Source="Assets/monkey.png" Width="64" Height="64"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock x:Name="HeadTitle" Text="Monkey" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="HeadSub" Text="Daily screen time that rolls over"
                           Foreground="#FF666672" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Pages -->
        <Grid Grid.Row="1">

            <!-- Start -->
            <StackPanel x:Name="PageStart">
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,14">
                    Monkey gives you a daily allowance of computer time. Whatever you don't
                    spend doesn't expire — it rolls over, up to a cap. When the balance hits
                    zero, you get signed out.
                </TextBlock>
                <TextBlock x:Name="StatusLine" Style="{StaticResource Hint}" Margin="0,0,0,18"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StartInstallButton" Content="Install"
                            Click="OnGoToInstall" Margin="0,0,0,0" IsDefault="True"/>
                    <Button x:Name="StartUninstallButton" Content="Remove" Click="OnGoToUninstall"/>
                </StackPanel>
            </StackPanel>

            <!-- Install -->
            <StackPanel x:Name="PageInstall" Visibility="Collapsed">
                <TextBlock Text="How much time should it be?" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Per day:" Style="{StaticResource RowLabel}" Margin="0,5,12,5"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="DailyBox" Text="30" Style="{StaticResource Field}" Margin="0,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="minutes" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Balance cap:" Style="{StaticResource RowLabel}" Margin="0,5,12,5"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="CapBox" Text="240" Style="{StaticResource Field}" Margin="0,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="minutes — the most that can pile up" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Top-up limit:" Style="{StaticResource RowLabel}" Margin="0,5,12,5"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="GrantBox" Text="240" Style="{StaticResource Field}" Margin="0,5"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="minutes per top-up — can't be changed later" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="Master password" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8">
                    The only key. Keep it off this machine — or hand it to someone you trust.
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Password:" Style="{StaticResource RowLabel}" Width="100"/>
                    <PasswordBox x:Name="PasswordBox1" Width="230" Padding="5,4"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Repeat:" Style="{StaticResource RowLabel}" Width="100"/>
                    <PasswordBox x:Name="PasswordBox2" Width="230" Padding="5,4"/>
                </StackPanel>

                <StackPanel x:Name="ExistingPanel" Visibility="Collapsed" Margin="0,14,0,0">
                    <TextBlock Text="Existing installation found" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="To replace it, enter the master password you set before."/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Current:" Style="{StaticResource RowLabel}" Width="100"/>
                        <PasswordBox x:Name="ExistingPasswordBox" Width="230" Padding="5,4"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Remove -->
            <StackPanel x:Name="PageUninstall" Visibility="Collapsed">
                <TextBlock Text="Remove Monkey" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14">
                    The service only lets go once it sees the master password. After that the
                    service, the program files and your stored time are removed.
                </TextBlock>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Master password:" Style="{StaticResource RowLabel}" Width="130"/>
                    <PasswordBox x:Name="UninstallPasswordBox" Width="230" Padding="5,4"/>
                </StackPanel>
            </StackPanel>

            <!-- Progress -->
            <StackPanel x:Name="PageProgress" Visibility="Collapsed">
                <TextBlock x:Name="ProgressTitle" Text="One moment …" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ProgressBar x:Name="Progress" Height="6" IsIndeterminate="True" Margin="0,0,0,12"/>
                <Border Background="#FFEFEFF4" CornerRadius="6" Padding="12,10">
                    <ScrollViewer x:Name="LogScroller" Height="220" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>

        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <TextBlock x:Name="FooterMessage" Style="{StaticResource Hint}" VerticalAlignment="Center"
                       MaxWidth="330" Margin="0,0,12,0"/>
            <Button x:Name="BackButton" Content="Back" Click="OnBack" Visibility="Collapsed"/>
            <Button x:Name="ActionButton" Content="Next" Click="OnAction" Visibility="Collapsed"/>
            <Button x:Name="CloseButton" Content="Close" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
