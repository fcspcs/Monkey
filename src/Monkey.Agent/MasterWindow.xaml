<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Monkey.Agent.MasterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monkey – Master-Steuerung"
        Width="520" Height="700"
        MinWidth="440" MinHeight="360"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFF7F7FA"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinWidth" Value="104"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Width" Value="66"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF77777F"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="16,16,16,16">
        <StackPanel>

            <TextBlock x:Name="BalanceText" Text="Guthaben: –"
                       FontSize="19" FontWeight="SemiBold" Margin="0,0,0,3" TextWrapping="Wrap"/>
            <TextBlock x:Name="StateText" Text="" Foreground="#FF555560"
                       Margin="0,0,0,14" TextWrapping="Wrap"/>

            <GroupBox Header="Master-Passwort">
                <StackPanel>
                    <PasswordBox x:Name="MasterPassword" Padding="4,4" FontSize="14"/>
                    <TextBlock Text="Wird für jede Aktion unten gebraucht und nur im Dienst geprüft."
                               Style="{StaticResource Hint}" Margin="0,5,0,0"/>
                    <Button x:Name="RevealChangePasswordButton" Content="Master-Passwort ändern …"
                            Click="OnRevealChangePassword" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="ChangePasswordGroup" Header="Master-Passwort ändern" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Neu:" Style="{StaticResource RowLabel}" Width="92"/>
                        <PasswordBox x:Name="NewPassword" Width="220" Padding="4,3"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Wiederholen:" Style="{StaticResource RowLabel}" Width="92"/>
                        <PasswordBox x:Name="NewPasswordRepeat" Width="220" Padding="4,3"/>
                    </StackPanel>
                    <Button x:Name="ChangePasswordButton" Content="Passwort ändern" Click="OnChangePassword"
                            HorizontalAlignment="Right" Margin="0,10,0,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Kontrolle pausieren">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Dauer:" Style="{StaticResource RowLabel}"/>
                    <ComboBox x:Name="PauseMinutes" Width="80" IsEditable="True" Text="60"
                              VerticalAlignment="Center">
                        <ComboBoxItem>15</ComboBoxItem>
                        <ComboBoxItem>30</ComboBoxItem>
                        <ComboBoxItem>60</ComboBoxItem>
                        <ComboBoxItem>120</ComboBoxItem>
                        <ComboBoxItem>240</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="Min." Margin="6,0,0,0"/>
                    <Button x:Name="ResumeButton" Content="Pause beenden" Click="OnResume" Margin="12,0,8,0"/>
                    <Button x:Name="PauseButton" Content="Pause starten" Click="OnPause" IsDefault="True"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Guthaben ändern">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="Minus30Button" Content="−30 min" Click="OnMinus30"
                                MinWidth="110" Margin="0,0,10,0"/>
                        <Button x:Name="Plus30Button" Content="+30 min" Click="OnPlus30" MinWidth="110"/>
                    </StackPanel>
                    <TextBlock x:Name="GrantBudgetText" Text="" Style="{StaticResource Hint}"
                               Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Einstellungen">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Pro Tag:" Style="{StaticResource RowLabel}" Margin="0,4,10,4"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="DailyMinutes" Style="{StaticResource Field}" Margin="0,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Minuten" Style="{StaticResource Hint}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Höchstguthaben:" Style="{StaticResource RowLabel}" Margin="0,4,10,4"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="CapMinutes" Style="{StaticResource Field}" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Minuten – Deckel für den Übertrag" Style="{StaticResource Hint}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Warnung bei:" Style="{StaticResource RowLabel}" Margin="0,4,10,4"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="WarnMinutes" Style="{StaticResource Field}" Margin="0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Minuten Restzeit" Style="{StaticResource Hint}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Vorwarnung:" Style="{StaticResource RowLabel}" Margin="0,4,10,4"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="GraceSeconds" Style="{StaticResource Field}" Margin="0,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Sekunden vor der Abmeldung" Style="{StaticResource Hint}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Puffer nach Anmeldung:" Style="{StaticResource RowLabel}" Margin="0,4,10,4"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="LoginGraceSeconds" Style="{StaticResource Field}" Margin="0,4"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Sekunden bei leerem Konto" Style="{StaticResource Hint}"/>
                    </Grid>

                    <CheckBox x:Name="PauseOnLock" Content="Uhr anhalten, wenn die Sitzung gesperrt ist" Margin="0,8,0,4"/>
                    <CheckBox x:Name="PauseOnScreensaver" Content="Uhr anhalten, wenn der Bildschirmschoner läuft"/>
                    <Button x:Name="SaveConfigButton" Content="Einstellungen speichern" Click="OnSaveConfig"
                            HorizontalAlignment="Right" Margin="0,10,0,0"/>

                    <Border x:Name="MessageBorder" Background="#FFE8E8EE" CornerRadius="5" Padding="10,7"
                            Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</Window>
