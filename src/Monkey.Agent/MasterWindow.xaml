<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Monkey.Agent.MasterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monkey – Control Panel"
        Width="700" Height="850"
        MinWidth="430" MinHeight="360"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFF7F7FA"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinWidth" Value="104"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,6"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Width" Value="66"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF77777F"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="GimmickColumn" Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Die Evolutionsstufe als volle Seitenspalte: randlos, ueber die ganze
             Fensterhoehe, ohne Beschriftung. Die Breite wird im Code aus der Hoehe
             berechnet, damit das Seitenverhaeltnis der Vorlage exakt erhalten
             bleibt und nichts verzerrt oder beschnitten wird. Der schwarze Grund
             fuellt alles, was durch Rundung daneben frei bleibt, und geht nahtlos
             in den dunklen Bildhintergrund ueber. Nimmt keine Mausklicks an. -->
        <Border x:Name="GimmickBackdrop"
                Grid.Column="0"
                Background="Black"
                IsHitTestVisible="False">
            <Image x:Name="Gimmick"
                   Stretch="UniformToFill"
                   VerticalAlignment="Stretch"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>

    <ScrollViewer Grid.Column="1"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="16,16,16,16">
        <StackPanel>

            <TextBlock x:Name="BalanceText" Text="Balance: –"
                       FontSize="19" FontWeight="SemiBold" Margin="0,0,0,3" TextWrapping="Wrap"/>
            <TextBlock x:Name="StateText" Text="" Foreground="#FF555560"
                       Margin="0,0,0,14" TextWrapping="Wrap"/>

            <GroupBox Header="Master password">
                <StackPanel>
                    <PasswordBox x:Name="MasterPassword" Padding="4,4" FontSize="14"/>
                    <TextBlock Text="Needed for everything below. Only the service ever checks it."
                               Style="{StaticResource Hint}" Margin="0,5,0,0"/>
                    <Button x:Name="RevealChangePasswordButton" Content="Change master password …"
                            Click="OnRevealChangePassword" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="ChangePasswordGroup" Header="Change master password" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="New:" Style="{StaticResource RowLabel}" Width="92"/>
                        <PasswordBox x:Name="NewPassword" Width="220" Padding="4,3"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Repeat:" Style="{StaticResource RowLabel}" Width="92"/>
                        <PasswordBox x:Name="NewPasswordRepeat" Width="220" Padding="4,3"/>
                    </StackPanel>
                    <Button x:Name="ChangePasswordButton" Content="Change password" Click="OnChangePassword"
                            HorizontalAlignment="Right" Margin="0,10,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- Zwei Welten, ein Fenster: die normalen Regler und die optionale
                 Telegram-Anbindung teilen sich den Platz per Tab. -->
            <TabControl Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,0">

                <TabItem Header="General">
                    <StackPanel Margin="0,12,0,0">

                        <GroupBox Header="Pause the limit">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="For:" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="PauseMinutes" Width="80" IsEditable="True" Text="60"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem>15</ComboBoxItem>
                                    <ComboBoxItem>30</ComboBoxItem>
                                    <ComboBoxItem>60</ComboBoxItem>
                                    <ComboBoxItem>120</ComboBoxItem>
                                    <ComboBoxItem>240</ComboBoxItem>
                                </ComboBox>
                                <TextBlock Text="min" Margin="6,0,0,0"/>
                                <Button x:Name="ResumeButton" Content="End pause" Click="OnResume" Margin="12,0,8,0"/>
                                <Button x:Name="PauseButton" Content="Start pause" Click="OnPause" IsDefault="True"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Adjust balance">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="Minus30Button" Content="−30 min" Click="OnMinus30"
                                            MinWidth="110" Margin="0,0,10,0"/>
                                    <Button x:Name="Plus30Button" Content="+30 min" Click="OnPlus30" MinWidth="110"/>
                                </StackPanel>
                                <TextBlock x:Name="GrantBudgetText" Text="" Style="{StaticResource Hint}"
                                           Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Settings">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Per day:" Style="{StaticResource RowLabel}" Margin="0,4,10,4"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="DailyMinutes" Style="{StaticResource Field}" Margin="0,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="minutes" Style="{StaticResource Hint}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Balance cap:" Style="{StaticResource RowLabel}" Margin="0,4,10,4"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="CapMinutes" Style="{StaticResource Field}" Margin="0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="minutes – how much can pile up" Style="{StaticResource Hint}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Warn at:" Style="{StaticResource RowLabel}" Margin="0,4,10,4"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="WarnMinutes" Style="{StaticResource Field}" Margin="0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="minutes left" Style="{StaticResource Hint}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Grace period:" Style="{StaticResource RowLabel}" Margin="0,4,10,4"/>
                                    <TextBox   Grid.Row="3" Grid.Column="1" x:Name="GraceSeconds" Style="{StaticResource Field}" Margin="0,4"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="seconds before signing out" Style="{StaticResource Hint}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Buffer after sign-in:" Style="{StaticResource RowLabel}" Margin="0,4,10,4"/>
                                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="LoginGraceSeconds" Style="{StaticResource Field}" Margin="0,4"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="seconds when the balance is empty" Style="{StaticResource Hint}"/>
                                </Grid>

                                <CheckBox x:Name="PauseOnLock" Content="Pause the clock while the session is locked" Margin="0,8,0,4"/>
                                <CheckBox x:Name="PauseOnScreensaver" Content="Pause the clock while the screensaver runs"/>
                                <Button x:Name="SaveConfigButton" Content="Save settings" Click="OnSaveConfig"
                                        HorizontalAlignment="Right" Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </TabItem>

                <TabItem Header="Telegram">
                    <StackPanel Margin="0,12,0,0">

                        <TextBlock TextWrapping="Wrap" Foreground="#FF555560" Margin="0,0,0,8"
                                   Text="Optional: two Telegram bots — one lets Monkey check the balance, one lets the friend add time or pause the limit remotely, no master password needed on this PC. Works even while the PC is off, through your own free Cloudflare Worker. The step-by-step guide is in the README."/>

                        <TextBlock x:Name="TelegramStatusText" Text="Not connected." FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <GroupBox Header="Connection">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Worker URL:" Style="{StaticResource RowLabel}" Width="118" Margin="0,4,10,4"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="WorkerUrlBox" Padding="4,3" Margin="0,4" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Sync secret:" Style="{StaticResource RowLabel}" Width="118" Margin="0,4,10,4"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="SyncSecretBox" IsReadOnly="True" Padding="4,3" Margin="0,4" VerticalAlignment="Center"/>
                                    <Button    Grid.Row="1" Grid.Column="2" x:Name="GenerateSecretButton" Content="Generate" Click="OnGenerateSyncSecret" Margin="8,4,0,4"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Monkey bot token:" Style="{StaticResource RowLabel}" Width="118" Margin="0,4,10,4"/>
                                    <PasswordBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="MonkeyTokenBox" Padding="4,3" Margin="0,4" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Friend bot token:" Style="{StaticResource RowLabel}" Width="118" Margin="0,4,10,4"/>
                                    <PasswordBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="FriendTokenBox" Padding="4,3" Margin="0,4" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           Text="Generate the sync secret here, store it in Cloudflare as the SYNC_SECRET secret, then connect. The bot tokens come from @BotFather; they go to your worker and are not kept on this PC."/>

                                <Button x:Name="ConnectTelegramButton" Content="Save &amp; connect" Click="OnTelegramConnect"
                                        HorizontalAlignment="Right" Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Pairing">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                           Text="Each chat has to prove itself once with a one-time code. Create a code, then send  /pair CODE  to the matching bot within 10 minutes."/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="PairMonkeyButton" Content="Code for Monkey's bot" Click="OnPairMonkey"/>
                                    <Button x:Name="PairFriendButton" Content="Code for the friend's bot" Click="OnPairFriend" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Disconnect">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                           Text="Removes both webhooks and wipes the worker's stored tokens, state and command queue."/>
                                <Button x:Name="TelegramOffButton" Content="Disconnect Telegram" Click="OnTelegramOff"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </TabItem>

            </TabControl>

            <Border x:Name="MessageBorder" Background="#FFE8E8EE" CornerRadius="5" Padding="10,7"
                    Visibility="Collapsed" Margin="0,4,0,0">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
    </Grid>
</Window>
