<Window x:Class="Monkey.Agent.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monkey"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        UseLayoutRounding="True"
        Cursor="Hand"
        MouseLeftButtonUp="OnClick"
        ToolTip="Click to open the control panel">

    <Border x:Name="Panel"
            CornerRadius="12"
            Padding="16,9"
            Background="#E0101014"
            BorderBrush="#33FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel MinWidth="118" VerticalAlignment="Center">
                <TextBlock x:Name="TimeLabel"
                           Text="--:--:--"
                           FontFamily="Segoe UI Semibold"
                           FontSize="23"
                           Foreground="#F2FFFFFF"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="CaptionLabel"
                           Text="left"
                           FontFamily="Segoe UI"
                           FontSize="10.5"
                           Foreground="#99FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,1,0,0"/>
            </StackPanel>

            <!-- Erscheint nur unter dem Mauszeiger, rechts neben der Zeit. Das
                 Fenster ist rechts verankert und waechst dadurch nach links, der
                 Zeiger bleibt also im Fenster - kein Flackern. -->
            <Image x:Name="HoverIcon"
                   Source="Assets/monkey.png"
                   Width="36" Height="36"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </StackPanel>
    </Border>
</Window>
