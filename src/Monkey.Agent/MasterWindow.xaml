<?xml version="1.0" encoding="utf-8"?>
<ui:ChromeWindow x:Class="Monkey.Agent.MasterWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="clr-namespace:Monkey.Ui"
                 Style="{StaticResource AppWindow}"
                 Title="Monkey"
                 CaptionPadding="228,0,0,0"
                 Width="880" Height="780"
                 MinWidth="700" MinHeight="560"
                 ResizeMode="CanResize"
                 SizeToContent="Manual"
                 WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Beschriftungen sitzen neben ihren Feldern, nicht darueber. -->
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="206"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--
            Die Seitenspalte: oben die Zahl, wegen der das Fenster geoeffnet wird,
            darunter die Wege, unten der Affe. Sie reicht bis an die Oberkante und
            damit hinter die Titelleiste - deshalb rueckt der Fenstertitel per
            CaptionPadding nach rechts neben sie.
        -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="26,62,20,0">
                    <TextBlock Text="Balance"
                               FontSize="11"
                               Foreground="{StaticResource SidebarFaintBrush}"/>
                    <TextBlock x:Name="BalanceText" Text="–"
                               FontFamily="{StaticResource UiFontDisplay}"
                               FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource SidebarTextBrush}"
                               Margin="0,3,0,0"/>
                    <TextBlock x:Name="StateText"
                               FontSize="11.5" LineHeight="16"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"
                               Foreground="{StaticResource SidebarMutedBrush}"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="14,28,14,0">
                    <!-- Zuerst der Rueckblick: Wer das Fenster oeffnet, will meist
                         sehen, wie es laeuft. Eingriffe stehen daneben, nicht davor. -->
                    <RadioButton x:Name="NavStatistics" Content="Statistics" Tag="Statistics"
                                 GroupName="Nav" IsChecked="True"
                                 Style="{StaticResource NavItem}" Checked="OnNavigate"/>
                    <RadioButton Content="Exceptions" Tag="Exceptions"
                                 GroupName="Nav" Style="{StaticResource NavItem}" Checked="OnNavigate"/>
                    <RadioButton Content="Display" Tag="Display"
                                 GroupName="Nav" Style="{StaticResource NavItem}" Checked="OnNavigate"/>
                    <RadioButton Content="Settings" Tag="Settings"
                                 GroupName="Nav" Style="{StaticResource NavItem}" Checked="OnNavigate"/>
                    <RadioButton Content="Telegram" Tag="Telegram"
                                 GroupName="Nav" Style="{StaticResource NavItem}" Checked="OnNavigate"/>
                    <RadioButton Content="Protection" Tag="Protection"
                                 GroupName="Nav" Style="{StaticResource NavItem}" Checked="OnNavigate"/>
                </StackPanel>

                <!--
                    Die Evolutionsstufe. Waagerecht wird sie nie beschnitten:
                    ihre Hoehe rechnet SizeGimmick aus der Spaltenbreite aus, sie
                    fuellt also immer genau von Rand zu Rand. Links und rechts
                    sind die Kanten des Bildes die einzige Stelle, an der es
                    nicht in Schwarz ausklingt - dort darf nichts fehlen.

                    Senkrecht darf sie auslaufen, aber nur mittig verankert: Der
                    Affe sitzt in der Mitte der hohen Vorlage, das obere Drittel
                    ist reines Schwarz. Oben ausgerichtet zeigte der Anschnitt
                    genau dieses Schwarz - und der Affe war weg. Oben und unten
                    legt sich ein Verlauf in die Farbe der Spalte darueber, damit
                    der Anschnitt keine sichtbare Kante hinterlaesst.
                -->
                <Grid x:Name="GimmickBox" Grid.Row="2" Margin="0,22,0,0"
                      ClipToBounds="True"
                      IsHitTestVisible="False">
                    <Image x:Name="Gimmick"
                           Stretch="Fill"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="0.17"/>
                                <GradientStop Color="#00000000" Offset="0.80"/>
                                <GradientStop Color="#FF000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <!-- Alle Seiten liegen uebereinander; sichtbar ist immer genau
                     eine. Die Breite ist gedeckelt: ein Satz, der ueber einen
                     ganzen Bildschirm laeuft, liest sich nicht mehr. -->
                <Grid Margin="34,66,30,34" MaxWidth="760">

                    <!-- ============================================== Exceptions -->

                    <!-- Alles hier bricht bewusst mit der Regel: Zeit dazugeben,
                         abziehen, die Uhr anhalten. Deshalb verlangt jede Taste
                         auf dieser Seite das Master-Passwort. -->
                    <StackPanel x:Name="PageExceptions" Visibility="Collapsed">

                        <GroupBox Header="Add or take time">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="Plus30Button" Content="+30 min"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="OnPlus30" MinWidth="126" MinHeight="40"/>
                                    <Button x:Name="Minus30Button" Content="−30 min"
                                            Click="OnMinus30" MinWidth="126" MinHeight="40"
                                            Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="GrantBudgetText" Style="{StaticResource Hint}"
                                           VerticalAlignment="Top" Margin="0,12,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Pause the limit">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="PauseMinutes" Text="60"
                                             Style="{StaticResource NumberField}"/>
                                    <TextBlock Text="minutes" Style="{StaticResource Hint}" Margin="10,0,18,0"/>
                                    <Button Content="15" Tag="15" Style="{StaticResource ChipButton}" Click="OnPausePreset" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <Button Content="30" Tag="30" Style="{StaticResource ChipButton}" Click="OnPausePreset" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <Button Content="60" Tag="60" Style="{StaticResource ChipButton}" Click="OnPausePreset" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <Button Content="120" Tag="120" Style="{StaticResource ChipButton}" Click="OnPausePreset" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <Button Content="240" Tag="240" Style="{StaticResource ChipButton}" Click="OnPausePreset" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button x:Name="PauseButton" Content="Start pause"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="OnPause" IsDefault="True"/>
                                    <Button x:Name="ResumeButton" Content="End pause"
                                            Click="OnResume" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>

                    <!-- ============================================== Statistics -->

                    <StackPanel x:Name="PageStatistics">

                        <!-- Eine Filterzeile fuer das ganze Blatt. Sie bricht um,
                             wenn das Fenster schmal wird, statt zu beschneiden. -->
                        <WrapPanel Margin="0,0,0,16">
                            <Border Background="{StaticResource SurfaceSunkenBrush}"
                                    CornerRadius="{StaticResource PanelRadius}" Padding="3" Margin="0,0,10,10">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="MetricUsage" Content="Screen time" Tag="Usage"
                                                 GroupName="Metric" IsChecked="True"
                                                 Style="{StaticResource SegmentButton}" Checked="OnMetricChanged"/>
                                    <RadioButton Content="Banked" Tag="Banked"
                                                 GroupName="Metric"
                                                 Style="{StaticResource SegmentButton}" Checked="OnMetricChanged"/>
                                    <RadioButton Content="Weekday" Tag="Weekday"
                                                 GroupName="Metric"
                                                 Style="{StaticResource SegmentButton}" Checked="OnMetricChanged"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceSunkenBrush}"
                                    CornerRadius="{StaticResource PanelRadius}" Padding="3" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="7 days" Tag="7"
                                                 GroupName="Range"
                                                 Style="{StaticResource SegmentButton}" Checked="OnRangeChanged"/>
                                    <RadioButton x:Name="Range30" Content="30 days" Tag="30" IsChecked="True"
                                                 GroupName="Range"
                                                 Style="{StaticResource SegmentButton}" Checked="OnRangeChanged"/>
                                    <RadioButton Content="90 days" Tag="90"
                                                 GroupName="Range"
                                                 Style="{StaticResource SegmentButton}" Checked="OnRangeChanged"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- Eine Aussage, eine Zahl - statt vier Kacheln, die
                             dasselbe in klein wiederholen. -->
                        <TextBlock x:Name="StatHeadline" Text="–"
                                   Style="{StaticResource Display}" FontSize="30"/>
                        <TextBlock x:Name="StatContext" Style="{StaticResource Body}"
                                   VerticalAlignment="Top" Margin="0,5,0,0"/>

                        <Grid Height="300" Margin="0,22,0,0">
                            <ui:ColumnChart x:Name="UsageChart"/>
                            <ui:TrendChart x:Name="BalanceChart" Visibility="Collapsed"/>
                            <ui:ColumnChart x:Name="WeekdayChart" Visibility="Collapsed"/>
                        </Grid>

                        <!-- Ein Diagramm darf nie der einzige Weg zu einer Zahl
                             sein - die Tabelle steht einen Klick daneben. -->
                        <Button x:Name="ToggleTableButton" Content="Show the numbers"
                                Style="{StaticResource SubtleButton}"
                                Click="OnToggleStatsTable"
                                HorizontalAlignment="Left" Margin="-10,16,0,0"/>

                        <StackPanel x:Name="StatsTableGroup" Visibility="Collapsed" Margin="0,18,0,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Day" Style="{StaticResource Hint}"/>
                                <TextBlock Grid.Column="1" Text="Used" Style="{StaticResource Hint}" Width="78" TextAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="Added" Style="{StaticResource Hint}" Width="78" TextAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="Balance" Style="{StaticResource Hint}" Width="86" TextAlignment="Right"/>
                            </Grid>
                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,6"/>

                            <ItemsControl x:Name="StatsTable">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Day}" FontSize="12"
                                                       Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Used}" FontSize="12" Width="78"
                                                       TextAlignment="Right" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Added}" FontSize="12" Width="78"
                                                       TextAlignment="Right" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Balance}" FontSize="12" Width="86"
                                                       TextAlignment="Right" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                    </StackPanel>

                    <!-- ================================================= Display -->

                    <StackPanel x:Name="PageDisplay" Visibility="Collapsed">

                        <TextBlock Style="{StaticResource Body}" VerticalAlignment="Top" Margin="0,0,0,30"
                                   Text="How the little clock in the screen corner looks and behaves. None of this touches the limit — it is only the display, which is why it needs no master password. The same choices sit in the tray icon's right-click menu."/>

                        <GroupBox Header="The overlay">
                            <StackPanel>
                                <CheckBox x:Name="ShowOverlayBox" Style="{StaticResource Switch}"
                                          Content="Show the overlay" Click="OnDisplayChanged"/>
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Top" Margin="0,5,0,0"
                                           Text="Ctrl + Alt + Shift + T does the same from anywhere. Hiding it changes nothing about the limit."/>

                                <Border Style="{StaticResource RowRule}"/>

                                <CheckBox x:Name="ShowBackgroundBox" Style="{StaticResource Switch}"
                                          Content="Show the box behind the number" Click="OnDisplayChanged"/>
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Top" Margin="0,5,0,0"
                                           Text="Without it only the bare number floats on the desktop."/>

                                <Border Style="{StaticResource RowRule}"/>

                                <CheckBox x:Name="ShowHoverIconBox" Style="{StaticResource Switch}"
                                          Content="Show the monkey when you point at it" Click="OnDisplayChanged"/>

                                <Border Style="{StaticResource RowRule}"/>

                                <CheckBox x:Name="CountUpBox" Style="{StaticResource Switch}"
                                          Content="Count the time used instead of the time left" Click="OnDisplayChanged"/>
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Top" Margin="0,5,0,0"
                                           Text="Pointing at the overlay always shows the other number."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Screen corner">
                            <Border Background="{StaticResource SurfaceSunkenBrush}"
                                    CornerRadius="{StaticResource PanelRadius}"
                                    Padding="3" HorizontalAlignment="Left">
                                <WrapPanel x:Name="CornerChoices"/>
                            </Border>
                        </GroupBox>

                        <GroupBox Header="Colour of the number">
                            <StackPanel>
                                <Border Background="{StaticResource SurfaceSunkenBrush}"
                                        CornerRadius="{StaticResource PanelRadius}"
                                        Padding="3" HorizontalAlignment="Left">
                                    <WrapPanel x:Name="AutoColorChoices"/>
                                </Border>
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Top" Margin="0,10,0,0"
                                           Text="Automatic turns amber below 15 minutes and red below 5. The two versions are tuned for dark and for light desktops."/>

                                <TextBlock Text="Or a fixed colour" Margin="0,22,0,12"
                                           Foreground="{StaticResource TextBrush}"/>
                                <WrapPanel x:Name="ColorChoices"/>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>

                    <!-- ================================================ Settings -->

                    <StackPanel x:Name="PageSettings" Visibility="Collapsed">

                        <GroupBox Header="Allowance">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="Per day"/>
                                        <TextBlock Text="Lands in the account every morning" Style="{StaticResource Hint}"
                                                   VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox x:Name="DailyMinutes" Style="{StaticResource NumberField}"/>
                                        <TextBlock Text="min" Style="{StaticResource Hint}" Width="46" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource RowRule}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="Balance cap"/>
                                        <TextBlock Text="The most that can pile up" Style="{StaticResource Hint}"
                                                   VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox x:Name="CapMinutes" Style="{StaticResource NumberField}"/>
                                        <TextBlock Text="min" Style="{StaticResource Hint}" Width="46" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Running out">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="Warn at"/>
                                        <TextBlock Text="How much is left when the warning appears" Style="{StaticResource Hint}"
                                                   VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox x:Name="WarnMinutes" Style="{StaticResource NumberField}"/>
                                        <TextBlock Text="min left" Style="{StaticResource Hint}" Width="46" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource RowRule}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="Grace period"/>
                                        <TextBlock Text="Time to save your work before signing out" Style="{StaticResource Hint}"
                                                   VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox x:Name="GraceSeconds" Style="{StaticResource NumberField}"/>
                                        <TextBlock Text="sec" Style="{StaticResource Hint}" Width="46" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource RowRule}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="Buffer after signing in"/>
                                        <TextBlock Text="What you get when the balance is already empty" Style="{StaticResource Hint}"
                                                   VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox x:Name="LoginGraceSeconds" Style="{StaticResource NumberField}"/>
                                        <TextBlock Text="sec" Style="{StaticResource Hint}" Width="46" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Counting">
                            <StackPanel>
                                <CheckBox x:Name="PauseOnLock" Style="{StaticResource Switch}"
                                          Content="Stop the clock while the session is locked"/>
                                <Border Style="{StaticResource RowRule}"/>
                                <CheckBox x:Name="PauseOnScreensaver" Style="{StaticResource Switch}"
                                          Content="Stop the clock while the screensaver runs or the display is off"/>
                                <Border Style="{StaticResource RowRule}"/>
                                <CheckBox x:Name="AutoUpdateBox" Style="{StaticResource Switch}"
                                          Content="Install new releases automatically (signed updates only)"/>
                            </StackPanel>
                        </GroupBox>

                        <Button x:Name="SaveConfigButton" Content="Save settings"
                                Style="{StaticResource PrimaryButton}"
                                Click="OnSaveConfig"
                                HorizontalAlignment="Left" Margin="0,-8,0,0"/>

                        <TextBlock x:Name="VersionText" Style="{StaticResource Hint}"
                                   VerticalAlignment="Top" Margin="0,16,0,0"/>

                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,30,0,30"/>

                        <GroupBox Header="Master password" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}" VerticalAlignment="Top"
                                           Text="The only key to everything above. Changing it needs the current one, typed in the bar below."/>
                                <Button x:Name="RevealChangePasswordButton" Content="Change master password …"
                                        Style="{StaticResource SubtleButton}"
                                        Click="OnRevealChangePassword"
                                        HorizontalAlignment="Left" Margin="-10,10,0,0"/>

                                <StackPanel x:Name="ChangePasswordGroup" Visibility="Collapsed" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="New" Style="{StaticResource RowLabel}" Width="96" Margin="0,0,12,5"/>
                                        <ui:SecretBox Grid.Row="0" Grid.Column="1" x:Name="NewPassword" Width="346" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Repeat" Style="{StaticResource RowLabel}" Width="96" Margin="0,5,12,0"/>
                                        <ui:SecretBox Grid.Row="1" Grid.Column="1" x:Name="NewPasswordRepeat" Width="346" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Generate a strong password"
                                                Style="{StaticResource SubtleButton}"
                                                Click="OnGenerateNewPassword" Margin="-10,0,0,0"/>
                                        <Button Content="Copy new password"
                                                Style="{StaticResource ChipButton}"
                                                Click="OnCopyNewPassword" Margin="4,0,0,0"
                                                VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="ChangePasswordButton" Content="Change password"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="OnChangePassword"
                                            HorizontalAlignment="Left" Margin="0,16,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>

                    <!-- ================================================ Telegram -->

                    <StackPanel x:Name="PageTelegram" Visibility="Collapsed">

                        <Grid Margin="0,0,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="TelegramDot" Grid.Column="0"
                                     Width="8" Height="8"
                                     Fill="{StaticResource TextFaintBrush}"
                                     VerticalAlignment="Top" Margin="0,6,11,0"/>
                            <TextBlock Grid.Column="1" x:Name="TelegramStatusText"
                                       Text="Not connected."
                                       Style="{StaticResource Body}"
                                       VerticalAlignment="Top"
                                       Foreground="{StaticResource TextBrush}"/>
                        </Grid>

                        <!-- Erst einrichten. Sobald das steht, verschwindet dieser
                             ganze Block und macht Platz fuer den Betrieb. -->
                        <StackPanel x:Name="TelegramSetupPanel">

                            <!-- Ruhiger Einstieg statt Formularwand: erst steht
                                 hier, was das bringt und was man braucht. Felder
                                 kommen danach, eines nach dem anderen. -->
                            <StackPanel x:Name="TelegramIntroPanel">
                                <GroupBox Header="Connect your phone">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Body}" VerticalAlignment="Top" Margin="0,0,0,14"
                                                   Text="Check the balance, add time and pause Monkey from Telegram — even while this PC is off. Two bots keep the roles apart: yours only reports, the friend's may give."/>
                                        <Border Background="{StaticResource SurfaceSunkenBrush}" CornerRadius="{StaticResource PanelRadius}"
                                                Padding="16,12" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="You will need" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                                                <TextBlock Text="· a Telegram account" Style="{StaticResource Body}" VerticalAlignment="Top" Margin="0,0,0,4"/>
                                                <TextBlock Text="· a free Cloudflare account — it relays the messages, no domain needed" Style="{StaticResource Body}" VerticalAlignment="Top" Margin="0,0,0,4"/>
                                                <TextBlock Text="· about ten minutes" Style="{StaticResource Body}" VerticalAlignment="Top"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Top"
                                                   Text="Five small steps, one thing at a time. Nothing changes in either account before the final review, and the master password never leaves this PC."/>
                                    </StackPanel>
                                </GroupBox>
                                <Button Content="Start setup" Style="{StaticResource PrimaryButton}"
                                        Click="OnTelegramSetupStart" HorizontalAlignment="Right"/>

                                <!-- Der manuelle Altweg bleibt direkt erreichbar,
                                     stoert den Einstieg eingeklappt aber nicht. -->
                                <Expander Header="Advanced: connect an existing worker instead" Margin="0,18,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Worker URL" Style="{StaticResource RowLabel}" Width="120" Margin="0,0,12,5"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="WorkerUrlBox" Margin="0,0,0,5"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Sync secret" Style="{StaticResource RowLabel}" Width="120" Margin="0,5,12,0"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="SyncSecretBox" IsReadOnly="True" Margin="0,5,0,0"
                                                     GotKeyboardFocus="OnSelectAllOnFocus" PreviewMouseLeftButtonDown="OnReadOnlyFieldClick"/>
                                            <Button Grid.Row="1" Grid.Column="2" x:Name="GenerateSecretButton" Content="Generate"
                                                    Click="OnGenerateSyncSecret" MinWidth="90" Margin="10,5,0,0"/>
                                        </Grid>
                                        <Button x:Name="ConnectTelegramButton" Content="Connect existing worker"
                                                Click="OnTelegramConnect" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <!-- Ab hier der gefuehrte Weg. Immer nur die Karte des
                                 aktuellen Schritts ist sichtbar. -->
                            <StackPanel x:Name="TelegramStepsPanel" Visibility="Collapsed">

                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock x:Name="TelegramSetupStepText"
                                               Text="Step 1 of 5 · Monkey's bot"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,0,0,9"/>
                                    <UniformGrid Columns="5" Height="4">
                                        <Border x:Name="TelegramStep1Indicator" CornerRadius="2" Margin="0,0,5,0"/>
                                        <Border x:Name="TelegramStep2Indicator" CornerRadius="2" Margin="0,0,5,0"/>
                                        <Border x:Name="TelegramStep3Indicator" CornerRadius="2" Margin="0,0,5,0"/>
                                        <Border x:Name="TelegramStep4Indicator" CornerRadius="2" Margin="0,0,5,0"/>
                                        <Border x:Name="TelegramStep5Indicator" CornerRadius="2"/>
                                    </UniformGrid>
                                </StackPanel>

                                <!-- Step 1: Monkeys eigener Bot. Drei fertige
                                     Nachrichten, direkt danach der Token - so wie
                                     BotFather ihn auch zeigt. -->
                                <StackPanel x:Name="TelegramMonkeyBotStep">
                                    <GroupBox Header="Create Monkey's bot">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Body}" VerticalAlignment="Top" Margin="0,0,0,14"
                                                       Text="This bot answers you with balance and status — nothing more. Open @BotFather and paste the three prepared messages, one after another. If Telegram says the username is taken, generate new suggestions."/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                                <Button Content="Open @BotFather" Click="OnOpenBotFather"/>
                                                <Button Content="New name suggestions" Click="OnRegenerateBotNames"
                                                        Style="{StaticResource SubtleButton}" Margin="6,0,0,0"/>
                                            </StackPanel>

                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="1 · Command" Style="{StaticResource Hint}"/>
                                                <TextBox Grid.Row="0" Grid.Column="1" Text="/newbot" IsReadOnly="True" Margin="0,0,8,5"
                                                         GotKeyboardFocus="OnSelectAllOnFocus" PreviewMouseLeftButtonDown="OnReadOnlyFieldClick"/>
                                                <Button Grid.Row="0" Grid.Column="2" Content="Copy" Tag="newbot"
                                                        Style="{StaticResource ChipButton}" Click="OnCopyTelegramSetupValue" Margin="0,0,0,5"/>
                                                <TextBlock Grid.Row="1" Text="2 · Name" Style="{StaticResource Hint}"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="MonkeyBotNameBox" IsReadOnly="True" Margin="0,0,8,5"
                                                         GotKeyboardFocus="OnSelectAllOnFocus" PreviewMouseLeftButtonDown="OnReadOnlyFieldClick"/>
                                                <Button Grid.Row="1" Grid.Column="2" Content="Copy" Tag="monkey-name"
                                                        Style="{StaticResource ChipButton}" Click="OnCopyTelegramSetupValue" Margin="0,0,0,5"/>
                                                <TextBlock Grid.Row="2" Text="3 · Username" Style="{StaticResource Hint}"/>
                                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="MonkeyBotUsernameBox" IsReadOnly="True" Margin="0,0,8,0"
                                                         GotKeyboardFocus="OnSelectAllOnFocus" PreviewMouseLeftButtonDown="OnReadOnlyFieldClick"/>
                                                <Button Grid.Row="2" Grid.Column="2" Content="Copy" Tag="monkey-username"
                                                        Style="{StaticResource ChipButton}" Click="OnCopyTelegramSetupValue"/>
                                            </Grid>

                                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Top" Margin="0,0,0,10"
                                                       Text="After the third message BotFather replies with this bot's token. Copy it completely and paste it here."/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="132"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Monkey bot token" Style="{StaticResource RowLabel}" Margin="0,0,12,0"/>
                                                <ui:SecretBox Grid.Column="1" x:Name="MonkeyTokenBox" Margin="0,0,8,0"/>
                                                <Button Grid.Column="2" Content="Paste" Tag="monkey-token"
                                                        Style="{StaticResource ChipButton}" Click="OnPasteTelegramSetupValue"/>
                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>
                                    <Grid>
                                        <Button Content="Back" Click="OnTelegramSetupBack" HorizontalAlignment="Left"/>
                                        <Button Content="Continue to the friend's bot" Style="{StaticResource PrimaryButton}"
                                                Click="OnTelegramSetupNext" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Step 2: derselbe Ablauf fuer den Bot der
                                     Vertrauensperson. -->
                                <StackPanel x:Name="TelegramFriendBotStep" Visibility="Collapsed">
                                    <GroupBox Header="Create the friend's bot">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Body}" VerticalAlignment="Top" Margin="0,0,0,14"
                                                       Text="This bot belongs to the person who holds the master password: it may add time and pause. Same routine in @BotFather — three messages, then the token."/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                                <Button Content="Open @BotFather" Click="OnOpenBotFather"/>
                                            </StackPanel>

                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="1 · Command" Style="{StaticResource Hint}"/>
                                                <TextBox Grid.Row="0" Grid.Column="1" Text="/newbot" IsReadOnly="True" Margin="0,0,8,5"
                                                         GotKeyboardFocus="OnSelectAllOnFocus" PreviewMouseLeftButtonDown="OnReadOnlyFieldClick"/>
                                                <Button Grid.Row="0" Grid.Column="2" Content="Copy" Tag="newbot"
                                                        Style="{StaticResource ChipButton}" Click="OnCopyTelegramSetupValue" Margin="0,0,0,5"/>
                                                <TextBlock Grid.Row="1" Text="2 · Name" Style="{StaticResource Hint}"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="FriendBotNameBox" IsReadOnly="True" Margin="0,0,8,5"
                                                         GotKeyboardFocus="OnSelectAllOnFocus" PreviewMouseLeftButtonDown="OnReadOnlyFieldClick"/>
                                                <Button Grid.Row="1" Grid.Column="2" Content="Copy" Tag="friend-name"
                                                        Style="{StaticResource ChipButton}" Click="OnCopyTelegramSetupValue" Margin="0,0,0,5"/>
                                                <TextBlock Grid.Row="2" Text="3 · Username" Style="{StaticResource Hint}"/>
                                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="FriendBotUsernameBox" IsReadOnly="True" Margin="0,0,8,0"
                                                         GotKeyboardFocus="OnSelectAllOnFocus" PreviewMouseLeftButtonDown="OnReadOnlyFieldClick"/>
                                                <Button Grid.Row="2" Grid.Column="2" Content="Copy" Tag="friend-username"
                                                        Style="{StaticResource ChipButton}" Click="OnCopyTelegramSetupValue"/>
                                            </Grid>

                                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Top" Margin="0,0,0,10"
                                                       Text="Again: BotFather's reply to the third message contains the token."/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="132"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Friend bot token" Style="{StaticResource RowLabel}" Margin="0,0,12,0"/>
                                                <ui:SecretBox Grid.Column="1" x:Name="FriendTokenBox" Margin="0,0,8,0"/>
                                                <Button Grid.Column="2" Content="Paste" Tag="friend-token"
                                                        Style="{StaticResource ChipButton}" Click="OnPasteTelegramSetupValue"/>
                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>
                                    <Grid>
                                        <Button Content="Back" Click="OnTelegramSetupBack" HorizontalAlignment="Left"/>
                                        <Button Content="Continue to Cloudflare" Style="{StaticResource PrimaryButton}"
                                                Click="OnTelegramSetupNext" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Step 3: aktueller Cloudflare-Pfad laut offizieller
                                     Dokumentation (Account Home -> Search). -->
                                <StackPanel x:Name="TelegramAccountStep" Visibility="Collapsed">
                                <GroupBox Header="Choose the Cloudflare account">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Body}" VerticalAlignment="Top" Margin="0,0,0,14"
                                                   Text="Monkey needs the 32-character Account ID of the account that will own the Worker. A domain is not required."/>
                                        <Border Background="{StaticResource SurfaceSunkenBrush}" CornerRadius="{StaticResource PanelRadius}"
                                                Padding="16,12" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="1 · Open Workers &amp; Pages and select the account." Style="{StaticResource Body}" VerticalAlignment="Top" Margin="0,0,0,6"/>
                                                <TextBlock Text="2 · If Cloudflare asks for a workers.dev subdomain, choose one once." Style="{StaticResource Body}" VerticalAlignment="Top" Margin="0,0,0,6"/>
                                                <TextBlock Text="3 · Press Ctrl+K, type “Copy account ID”, then select that result." Style="{StaticResource Body}" VerticalAlignment="Top"/>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Button Content="Open Workers &amp; Pages" Click="OnOpenCloudflareDashboard"/>
                                            <Button Content="Open official ID guide" Click="OnOpenCloudflareAccountDocs"
                                                    Style="{StaticResource SubtleButton}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="108"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Account ID" Style="{StaticResource RowLabel}" Margin="0,0,12,0"/>
                                            <TextBox Grid.Column="1" x:Name="CloudflareAccountIdBox" Margin="0,0,8,0"/>
                                            <Button Grid.Column="2" Content="Paste" Tag="account-id"
                                                    Style="{StaticResource ChipButton}" Click="OnPasteTelegramSetupValue"/>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>
                                <Grid>
                                    <Button Content="Back" Click="OnTelegramSetupBack" HorizontalAlignment="Left"/>
                                    <Button Content="Continue to API token" Style="{StaticResource PrimaryButton}"
                                            Click="OnTelegramSetupNext" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                                <!-- Step 4: Der Link ist eine offizielle Cloudflare-
                                     Template-URL und fuellt die Rechte bereits aus. -->
                                <StackPanel x:Name="TelegramTokenStep" Visibility="Collapsed">
                                <GroupBox Header="Create a one-time API token">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Body}" VerticalAlignment="Top" Margin="0,0,0,14"
                                                   Text="The button opens Cloudflare's token form with Monkey's two required permissions already filled in. Do not use the Global API Key."/>
                                        <Border Background="{StaticResource SurfaceSunkenBrush}" CornerRadius="{StaticResource PanelRadius}"
                                                Padding="16,12" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="1 · Confirm Account · Workers Scripts · Edit." Style="{StaticResource Body}" VerticalAlignment="Top" Margin="0,0,0,6"/>
                                                <TextBlock Text="2 · Confirm Account · Workers KV Storage · Edit." Style="{StaticResource Body}" VerticalAlignment="Top" Margin="0,0,0,6"/>
                                                <TextBlock Text="3 · Click Continue to summary, then Create Token." Style="{StaticResource Body}" VerticalAlignment="Top" Margin="0,0,0,6"/>
                                                <TextBlock Text="4 · Copy the token immediately; Cloudflare shows it only once." Style="{StaticResource Body}" VerticalAlignment="Top"/>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Button Content="Open pre-filled token form" Click="OnOpenCloudflareToken"/>
                                            <Button Content="Open official token guide" Click="OnOpenCloudflareTokenDocs"
                                                    Style="{StaticResource SubtleButton}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="108"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="API token" Style="{StaticResource RowLabel}" Margin="0,0,12,0"/>
                                            <ui:SecretBox Grid.Column="1" x:Name="CloudflareApiTokenBox" Margin="0,0,8,0"/>
                                            <Button Grid.Column="2" Content="Paste" Tag="api-token"
                                                    Style="{StaticResource ChipButton}" Click="OnPasteTelegramSetupValue"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Top" Margin="0,12,0,0"
                                                   Text="Monkey uses this token for this deployment only, never stores it, and clears it from the window after the attempt."/>
                                    </StackPanel>
                                </GroupBox>
                                <Grid>
                                    <Button Content="Back" Click="OnTelegramSetupBack" HorizontalAlignment="Left"/>
                                    <Button Content="Review deployment" Style="{StaticResource PrimaryButton}"
                                            Click="OnTelegramSetupNext" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                                <!-- Step 5: Erst hier wird etwas in Cloudflare
                                     veraendert. Die Zusammenfassung macht das klar. -->
                                <StackPanel x:Name="TelegramDeployStep" Visibility="Collapsed">
                                <GroupBox Header="Review and connect">
                                    <StackPanel>
                                        <TextBlock x:Name="TelegramSetupReviewText" Style="{StaticResource Body}"
                                                   VerticalAlignment="Top" Margin="0,0,0,14"/>
                                        <Border Background="{StaticResource SurfaceSunkenBrush}" CornerRadius="{StaticResource PanelRadius}"
                                                Padding="16,12">
                                            <TextBlock Style="{StaticResource Body}" VerticalAlignment="Top"
                                                       Text="Monkey will create one dedicated KV store and one Worker, install encrypted secrets, register both Telegram webhooks, and keep only the Worker URL plus an encrypted sync secret on this PC."/>
                                        </Border>
                                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Top" Margin="0,12,0,0"
                                                   Text="After a successful deployment, revoke this one-time API token in Cloudflare. Pairing the two chats is the next step."/>
                                    </StackPanel>
                                </GroupBox>
                                <Grid>
                                    <Button Content="Back" Click="OnTelegramSetupBack" HorizontalAlignment="Left"/>
                                    <Button x:Name="DeployTelegramButton" Content="Deploy worker &amp; connect"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="OnTelegramDeploy" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            </StackPanel>

                        </StackPanel>

                        <!-- Und ab hier der Betrieb - erst sichtbar, wenn es
                             tatsaechlich etwas zu bedienen gibt. -->
                        <StackPanel x:Name="TelegramLivePanel" Visibility="Collapsed">

                            <GroupBox Header="Pair the chats">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Body}" VerticalAlignment="Top" Margin="0,0,0,14"
                                               Text="Create a one-time code, then send /pair CODE to the matching bot within 10 minutes."/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="PairMonkeyButton" Content="Code for Monkey's bot" Click="OnPairMonkey"/>
                                        <Button x:Name="PairFriendButton" Content="Code for the friend's bot" Click="OnPairFriend" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="The worker">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Body}" VerticalAlignment="Top" Margin="0,0,0,14"
                                               Text="Checking only asks the worker how it is doing. Updating changes your Cloudflare account and needs the Account ID plus a fresh API token."/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CheckWorkerButton" Content="Check worker" Click="OnWorkerCheck"/>
                                        <Button x:Name="UpdateWorkerButton" Content="Update worker" Click="OnWorkerUpdate" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="ShowTelegramSetupButton" Content="Set it up again …"
                                            Style="{StaticResource SubtleButton}"
                                            Click="OnShowTelegramSetup"
                                            HorizontalAlignment="Left" Margin="-10,10,0,0"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Disconnect">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Body}" VerticalAlignment="Top" Margin="0,0,0,14"
                                               Text="Disconnecting removes both webhooks and wipes the worker's stored tokens, state and command queue. Removing goes further and deletes Monkey's managed worker from Cloudflare altogether."/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="TelegramOffButton" Content="Disconnect Telegram"
                                                Style="{StaticResource DangerButton}"
                                                Click="OnTelegramOff"/>
                                        <Button x:Name="RemoveWorkerButton" Content="Remove worker"
                                                Style="{StaticResource DangerButton}"
                                                Click="OnWorkerRemove" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                        </StackPanel>

                    </StackPanel>

                    <!-- ============================================== Protection -->

                    <StackPanel x:Name="PageProtection" Visibility="Collapsed">

                        <TextBlock Style="{StaticResource Body}" VerticalAlignment="Top" Margin="0,0,0,30"
                                   Text="Monkey blocks casual stopping, replacement and removal. A person who can deliberately run code as Windows administrator can still become LocalSystem and remove any ordinary service."/>

                        <GroupBox Header="Windows account">
                            <StackPanel>
                                <TextBlock x:Name="AccountProtectionText" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextBrush}"
                                           LineHeight="19"
                                           VerticalAlignment="Top" Margin="0,0,0,12"/>
                                <TextBlock Style="{StaticResource Body}" VerticalAlignment="Top" Margin="0,0,0,16"
                                           Text="A separate admin account does not remove your files or developer profile. Your current profile may stay the daily account; Windows asks for the other account only when elevation is needed. If you know that password yourself, this is an extra hurdle rather than an absolute boundary."/>
                                <Button Content="Open account settings" Click="OnOpenAccountSettings" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Developer option">
                            <TextBlock Style="{StaticResource Body}" VerticalAlignment="Top"
                                       Text="For a strict boundary while retaining full admin rights for experiments, use an administrator account inside a development VM. Admin rights inside the VM cannot stop Monkey on the Windows host."/>
                        </GroupBox>

                        <GroupBox Header="Offline protection">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}" VerticalAlignment="Top" Margin="0,0,0,16"
                                           Text="BitLocker and Secure Boot do not stop an administrator inside Windows. They only make it harder to boot another system and edit Monkey's files from outside Windows."/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Open BitLocker" Click="OnOpenBitLocker"/>
                                    <Button Content="Show Secure Boot status" Click="OnOpenSystemInformation" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <!-- Der Schluessel liegt dort, wo er gebraucht wird: unter den
                 Schaltflaechen, die ihn verlangen - und nur auf den Seiten, auf
                 denen es etwas zu befugen gibt. -->
            <Border x:Name="AuthBar" Grid.Row="1"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="34,14,30,16">
                <Grid MaxWidth="760">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Master password"
                               Style="{StaticResource RowLabel}" Margin="0,0,14,0"/>
                    <ui:SecretBox Grid.Column="1" x:Name="MasterPassword"
                                  HorizontalAlignment="Left" MinWidth="326" MaxWidth="406"
                                  ToolTip="Needed for anything that changes the limit. Only the service ever checks it."/>
                </Grid>
            </Border>

            <!-- Echte Overlay-Rueckmeldung: Sie belegt keine Layout-Zeile und
                 erzeugt deshalb keinen kuenstlichen Footer. -->
            <Border x:Name="MessageBorder" Grid.RowSpan="2"
                    Panel.ZIndex="100"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="{StaticResource SuccessBrush}"
                    BorderBrush="{StaticResource SuccessBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource PanelRadius}"
                    Padding="16,11,10,11"
                    Margin="24,58,30,0"
                    Width="Auto" MaxWidth="430"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{StaticResource SuccessTextBrush}"/>
                    <Button Grid.Column="1" Content="×" Click="OnDismissToast"
                            Style="{StaticResource SubtleButton}"
                            Foreground="{Binding Foreground, ElementName=MessageText}"
                            FontSize="18" FontWeight="Normal"
                            Padding="7,1" Margin="8,-4,-3,-4"
                            ToolTip="Dismiss"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:ChromeWindow>
