<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TimeGuardAgent</AssemblyName>
    <RootNamespace>TimeGuard.Agent</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!--
    UseWindowsForms zieht System.Drawing und System.Windows.Forms als globale
    Usings herein und macht damit Color, Brush und Application mehrdeutig.
    Das Projekt ist WPF mit einem Tray-Symbol aus WinForms - also raus damit und
    die wenigen WinForms-Typen ueber Aliase ansprechen.
  -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TimeGuard.Core\TimeGuard.Core.csproj" />
  </ItemGroup>

</Project>
