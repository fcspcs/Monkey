<?xml version="1.0" encoding="utf-8"?>
<ui:ChromeWindow x:Class="Monkey.Setup.WizardWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="clr-namespace:Monkey.Ui"
                 Style="{StaticResource AppWindow}"
                 Title="Monkey Setup"
                 Width="700" Height="660"
                 MinWidth="560" MinHeight="520"
                 WindowStartupLocation="CenterScreen">

    <Grid Margin="{StaticResource CaptionInset}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopf: der Affe und wofuer das hier gut ist. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="34,8,30,28">
            <Image Source="Assets/monkey.png" Width="58" Height="58"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel VerticalAlignment="Center" Margin="18,0,0,0">
                <TextBlock x:Name="HeadTitle" Text="Monkey" Style="{StaticResource Display}" FontSize="26"/>
                <TextBlock x:Name="HeadSub" Text="Daily screen time that rolls over"
                           Style="{StaticResource Body}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Die Seiten stehen unmittelbar auf dem Blatt. Was zusammengehoert,
             zeigt der Abstand; abgesetzt wird die Fussleiste mit einer Haarlinie,
             nicht der ganze Inhalt mit einer Karte. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="34,0,30,12">

                    <!-- Start -->
                    <StackPanel x:Name="PageStart">
                        <TextBlock Style="{StaticResource Body}" Margin="0,0,0,16"
                                   Text="Monkey gives you a daily allowance of computer time. Whatever you don't spend doesn't expire — it rolls over, up to a cap. When the balance hits zero, you get signed out."/>
                        <TextBlock x:Name="StatusLine" Style="{StaticResource Hint}"
                                   VerticalAlignment="Top" Margin="0,0,0,22"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="StartInstallButton" Content="Install"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="130" MinHeight="38"
                                    Click="OnGoToInstall" IsDefault="True"/>
                            <Button x:Name="StartUninstallButton" Content="Remove"
                                    MinWidth="130" MinHeight="38" Margin="10,0,0,0"
                                    Click="OnGoToUninstall"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Install -->
                    <StackPanel x:Name="PageInstall" Visibility="Collapsed">
                        <TextBlock Text="How much time should it be?" Style="{StaticResource Title}" Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Per day" Style="{StaticResource RowLabel}" Margin="0,5,14,5"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="DailyBox" Text="30" Style="{StaticResource NumberField}" Margin="0,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="minutes" Style="{StaticResource Hint}" Margin="12,0,0,0"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Balance cap" Style="{StaticResource RowLabel}" Margin="0,5,14,5"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="CapBox" Text="240" Style="{StaticResource NumberField}" Margin="0,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="minutes — the most that can pile up" Style="{StaticResource Hint}" Margin="12,0,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Top-up limit" Style="{StaticResource RowLabel}" Margin="0,5,14,5"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="GrantBox" Text="240" Style="{StaticResource NumberField}" Margin="0,5"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="minutes per top-up — can't be changed later" Style="{StaticResource Hint}" Margin="12,0,0,0"/>
                        </Grid>

                        <Border Background="{StaticResource DividerBrush}" Height="1" Margin="0,22,0,20"/>

                        <TextBlock Text="Master password" Style="{StaticResource Title}" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Top" Margin="0,0,0,14"
                                   Text="The only key. Keep it off this machine — or hand it to someone you trust."/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Password" Style="{StaticResource RowLabel}" Width="110" Margin="0,0,12,5"/>
                            <ui:SecretBox Grid.Row="0" Grid.Column="1" x:Name="PasswordBox1" Width="336" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Repeat" Style="{StaticResource RowLabel}" Width="110" Margin="0,5,12,0"/>
                            <ui:SecretBox Grid.Row="1" Grid.Column="1" x:Name="PasswordBox2" Width="336" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="122,10,0,0">
                            <Button Content="Generate a strong password"
                                    Style="{StaticResource SubtleButton}"
                                    Click="OnGeneratePassword" Margin="-10,0,0,0"/>
                            <Button Content="Copy"
                                    Style="{StaticResource ChipButton}"
                                    Click="OnCopyGeneratedPassword" Margin="4,0,0,0"
                                    VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border x:Name="ExistingPanel" Visibility="Collapsed" Margin="0,20,0,0"
                                Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="{StaticResource AccentLineBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource PanelRadius}"
                                Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="Existing installation found"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentTextBrush}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Top" Margin="0,0,0,12"
                                           Text="To replace it, enter the master password you set before."/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Current" Style="{StaticResource RowLabel}" Width="110"/>
                                    <ui:SecretBox x:Name="ExistingPasswordBox" Width="336"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Remove -->
                    <StackPanel x:Name="PageUninstall" Visibility="Collapsed">
                        <TextBlock Text="Remove Monkey" Style="{StaticResource Title}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource Body}" Margin="0,0,0,20"
                                   Text="The service only lets go once it sees the master password. After that the service, the program files and your stored time are removed."/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Master password" Style="{StaticResource RowLabel}" Width="140"/>
                            <ui:SecretBox x:Name="UninstallPasswordBox" Width="336"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Progress -->
                    <StackPanel x:Name="PageProgress" Visibility="Collapsed">
                        <TextBlock x:Name="ProgressTitle" Text="One moment …" Style="{StaticResource Title}" Margin="0,0,0,14"/>
                        <ProgressBar x:Name="Progress" IsIndeterminate="True" Margin="0,0,0,18"/>
                        <Border Background="{StaticResource SurfaceSunkenBrush}"
                                CornerRadius="{StaticResource PanelRadius}" Padding="18,14">
                            <ScrollViewer x:Name="LogScroller" Height="230" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="LogText"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           LineHeight="18"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                </Grid>
        </ScrollViewer>

        <!-- Fussleiste: links die Rueckmeldung, rechts der Weg weiter. -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="34,16,30,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="FooterMessage" Grid.Column="0"
                           Style="{StaticResource Body}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,18,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Content="Back" Click="OnBack" Visibility="Collapsed"/>
                    <Button x:Name="ActionButton" Content="Next" Click="OnAction" Visibility="Collapsed"
                            Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/>
                    <Button x:Name="CloseButton" Content="Close" Click="OnClose" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:ChromeWindow>
